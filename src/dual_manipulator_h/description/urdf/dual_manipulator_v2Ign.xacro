<?xml version="1.0"?>
<robot name="dual_arm_manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find dual_manipulator_h)/description/urdf/manipulator_h_macro.xacro"/>

  <xacro:property name="pi" value="3.141592654"/>

  <xacro:property name="torso_radius" value="0.1"/> <xacro:property name="torso_height" value="0.8"/>
  <xacro:property name="torso_mass" value="5.0"/>

  <xacro:property name="shoulder_height" value="0.3"/>
  <xacro:property name="shoulder_forward" value="0.0"/>

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <joint name="base_to_torso" type="fixed">
    <parent link="base_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 ${torso_height/2}" rpy="0 0 0"/>
  </joint>

  <link name="torso_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${torso_radius}" length="${torso_height}"/>
      </geometry>
      <material name="torso_color">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${torso_radius}" length="${torso_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${torso_mass}"/>
      <inertia
        ixx="${torso_mass/12 * (3*torso_radius*torso_radius + torso_height*torso_height)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${torso_mass/12 * (3*torso_radius*torso_radius + torso_height*torso_height)}"
        iyz="0.0"
        izz="${torso_mass/2 * (torso_radius*torso_radius)}"/>
    </inertial>
  </link>

  <xacro:manipulator_h_arm
    prefix="left_"
    parent_link="torso_link"
    origin_xyz="${shoulder_forward} ${torso_radius} ${shoulder_height}"
    origin_rpy="${-pi/2} 0 0"
    />

  <xacro:manipulator_h_arm
    prefix="right_"
    parent_link="torso_link"
    origin_xyz="${shoulder_forward} -${torso_radius} ${shoulder_height}"
    origin_rpy="${pi/2} 0 0"/>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find dual_manipulator_h)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <mu1>1000.0</mu1>
    <mu2>1000.0</mu2>
    <kp>1e10</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="torso_link">
    <material>Gazebo/White</material>
    <mu1>1000.0</mu1>
    <mu2>1000.0</mu2>
  </gazebo>

</robot>